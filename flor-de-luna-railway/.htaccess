Options -Indexes
DirectoryIndex index.html

# Carpetas y archivos internos: no se pueden abrir desde el navegador
RedirectMatch 403 ^/(Base|\.git)(/|$)
<FilesMatch "^(database|migrar)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "^(Dockerfile|start\.sh|.*\.md|\.dockerignore|\.gitignore)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "same-origin"
</IfModule>
